---
/**
 * Contenedor liviano para una sección de precio de `/pricing/` (deck de precios §5).
 *
 * No decide qué tabla renderizar — eso lo sigue haciendo la página, pasando
 * `PricingTable` o `SubscriptionTable` como hijos. Esto solo repite el mismo H2 +
 * nota + enlace de vuelta a la página hoja en las cinco secciones, para que la página
 * en sí sea composición de secciones, no maquetación repetida cinco veces.
 */
interface Props {
  heading: string;
  id?: string;
  note?: string;
  linkLabel?: string;
  linkHref?: string;
}

const { heading, id, note, linkLabel, linkHref } = Astro.props;
---

<section class="pricing-agg-section" id={id}>
  <h2>{heading}</h2>
  <slot />
  {note && <p class="pricing-agg-section__note">{note}</p>}
  {
    linkLabel && linkHref && (
      <a class="pricing-agg-section__link" href={linkHref}>
        {linkLabel}
      </a>
    )
  }
</section>

<style>
  .pricing-agg-section {
    padding-block: var(--space-6);
    border-block-end: 1px solid var(--color-border);
  }

  .pricing-agg-section__note {
    font-style: italic;
    color: var(--color-fg-muted);
    margin-block-start: var(--space-2);
  }

  .pricing-agg-section__link {
    display: inline-block;
    margin-block-start: var(--space-2);
  }
</style>
