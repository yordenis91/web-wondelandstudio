---
/**
 * Cabecera: navegación, teléfono y selector de idioma.
 *
 * El selector no manda a la home del otro idioma — resuelve la página equivalente con
 * `getAlternate()`. Alguien leyendo la página de fotógrafo de bodas en inglés que pulsa
 * "ES" aterriza en `/es/west-palm-beach/fotografo-de-bodas/`, no en `/es/`. Perder el
 * contexto en el cambio de idioma es la forma más rápida de perder la visita.
 *
 * En móvil la navegación se colapsa tras un botón de tres rayas, **por mejora
 * progresiva**: los enlaces siempre están en el HTML servido (regla 1 de CLAUDE.md), y
 * el colapso solo ocurre si hay JavaScript. Sin JS el menú se ve desplegado y el sitio
 * es perfectamente usable — nunca queda contenido inalcanzable detrás de un botón
 * muerto. La clase `.js` la pone `Layout.astro` antes del primer pintado, así que no
 * hay parpadeo de menú abierto→cerrado.
 */
import {
  getAlternate,
  getLang,
  normalizePath,
  getServiceMatrix,
  getMatrixHref,
  SERVICE_LABELS,
  type Lang,
  type City,
} from '../i18n/routes.ts';
import { BUSINESS, getLocation, resolvedPhone } from '../data/business.ts';

interface Props {
  path: string;
}

const { path } = Astro.props;
const canonicalPath = normalizePath(path);
const lang: Lang = getLang(canonicalPath);
const other: Lang = lang === 'en' ? 'es' : 'en';

/** El equivalente en el otro idioma. Layout ya falló el build si no existiera. */
const otherHref = getAlternate(canonicalPath, other) ?? (other === 'en' ? '/' : '/es/');

interface NavLink {
  readonly kind: 'link';
  readonly href: string;
  readonly label: string;
}

/** Un hub en la nav lleva submenú — sus páginas de servicio `active`, nunca `planned`. */
interface NavHub {
  readonly kind: 'hub';
  readonly href: string;
  readonly label: string;
  readonly city: City;
}

const NAV: Readonly<Record<Lang, readonly (NavLink | NavHub)[]>> = {
  en: [
    { kind: 'hub', href: '/west-palm-beach/', label: 'West Palm Beach', city: 'wpb' },
    { kind: 'hub', href: '/port-st-lucie/', label: 'Port St. Lucie', city: 'psl' },
    { kind: 'link', href: '/pricing/', label: 'Pricing' },
    { kind: 'link', href: '/about-lisandra/', label: 'About' },
  ],
  es: [
    { kind: 'hub', href: '/es/west-palm-beach/', label: 'West Palm Beach', city: 'wpb' },
    { kind: 'hub', href: '/es/port-st-lucie/', label: 'Port St. Lucie', city: 'psl' },
    { kind: 'link', href: '/es/precios/', label: 'Precios' },
    { kind: 'link', href: '/es/sobre-lisandra/', label: 'Sobre Lisandra' },
  ],
};

const L = {
  en: { nav: 'Main', menu: 'Menu', overview: 'All {city} services', toggle: 'Show {city} services' },
  es: { nav: 'Principal', menu: 'Menú', overview: 'Todos los servicios de {city}', toggle: 'Ver servicios de {city}' },
}[lang];

/** Las páginas de servicio activas de un hub, resueltas a href + etiqueta. */
function activeServicesOf(city: City) {
  return getServiceMatrix(city)
    .filter((entry) => entry.status === 'active')
    .map((entry) => ({
      href: getMatrixHref(entry, lang),
      label: SERVICE_LABELS[entry.service]?.[lang] ?? entry.service,
    }));
}

const items = NAV[lang];
const home = lang === 'en' ? '/' : '/es/';
const phone = resolvedPhone(getLocation('wpb'));
---

<header class="site-header" data-site-header>
  <div class="site-header__bar container">
    <a class="site-header__logo" href={home}>{BUSINESS.legalName}</a>

    {/*
      `hidden` en el HTML servido: sin JS el botón no existe para nadie —ni visualmente
      ni para un lector de pantalla— porque no tendría nada que hacer. El script lo
      revela.
    */}
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
      hidden
    >
      <span class="nav-toggle__bars" aria-hidden="true"></span>
      <span class="visually-hidden">{L.menu}</span>
    </button>

    <div class="site-header__panel" id="site-nav" data-nav-panel>
      <nav aria-label={L.nav}>
        <ul class="site-header__nav">
          {
            items.map((item) => {
              if (item.kind === 'link') {
                const current = normalizePath(item.href) === canonicalPath;
                return (
                  <li>
                    <a href={item.href} aria-current={current ? 'page' : undefined}>
                      {item.label}
                    </a>
                  </li>
                );
              }

              const services = activeServicesOf(item.city);
              const onHub = normalizePath(item.href) === canonicalPath;
              const onService = services.some((s) => normalizePath(s.href) === canonicalPath);
              const current = onHub || onService;

              return (
                <li class="site-header__nav-item">
                  <a href={item.href} aria-current={current ? 'page' : undefined}>
                    {item.label}
                  </a>
                  {services.length > 0 && (
                    <details class="nav-dropdown">
                      <summary aria-label={L.toggle.replace('{city}', item.label)}>
                        <span aria-hidden="true">▾</span>
                      </summary>
                      <ul class="nav-dropdown__panel">
                        <li>
                          <a href={item.href} class="nav-dropdown__overview">
                            {L.overview.replace('{city}', item.label)}
                          </a>
                        </li>
                        {services.map((service) => (
                          <li>
                            <a
                              href={service.href}
                              aria-current={
                                normalizePath(service.href) === canonicalPath ? 'page' : undefined
                              }
                            >
                              {service.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </details>
                  )}
                </li>
              );
            })
          }
        </ul>
      </nav>

      <div class="site-header__aside">
        {
          phone && (
            <a class="site-header__phone" href={`tel:${phone.e164}`}>
              {phone.display}
            </a>
          )
        }
        {/* `lang` + `hreflang` para que un lector de pantalla anuncie el cambio de idioma. */}
        <a
          class="site-header__lang"
          href={otherHref}
          lang={other}
          hreflang={other}
          rel="alternate"
        >
          {other === 'en' ? 'English' : 'Español'}
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--header-height);
    flex-wrap: wrap;
  }

  .site-header__logo {
    font-weight: 700;
    text-decoration: none;
    letter-spacing: 0.02em;
    margin-inline-end: auto;
  }

  .site-header__panel {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .site-header__nav {
    display: flex;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    flex-wrap: wrap;
  }

  .site-header__nav a {
    font-size: var(--text-small);
    text-transform: uppercase;
    letter-spacing: var(--tracking-uppercase);
    text-decoration: none;
    color: var(--color-fg-muted);
    transition: color 0.3s ease;
  }

  .site-header__nav a:hover,
  .site-header__nav a[aria-current='page'] {
    color: var(--color-fg);
  }

  /* ── Submenú de hub ────────────────────────────────────────────────────────
     `<details>/<summary>` nativo, mismo principio que FAQ.astro: funciona sin
     JavaScript, con teclado, y el contenido está en el HTML servido — un buscador no
     necesita ejecutar nada para ver que "West Palm Beach" enlaza también a "Fotógrafo
     de Bodas". El enlace al hub vive aparte del `<summary>`, para no perder el click
     directo que ya tenía la nav: `<summary>` solo abre/cierra la lista. */
  .site-header__nav-item {
    display: flex;
    align-items: center;
    gap: 0.35em;
    position: relative;
  }

  .nav-dropdown {
    position: relative;
  }

  .nav-dropdown summary {
    display: block;
    cursor: pointer;
    list-style: none;
    color: var(--color-fg-muted);
    font-size: 0.7em;
    line-height: 1;
    padding: var(--space-1);
    margin: calc(var(--space-1) * -1);
  }

  .nav-dropdown summary::-webkit-details-marker {
    display: none;
  }

  .nav-dropdown summary:hover,
  .nav-dropdown[open] summary {
    color: var(--color-fg);
  }

  .nav-dropdown summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .nav-dropdown__panel {
    list-style: none;
    margin: 0;
    padding: var(--space-2);
    display: grid;
    gap: var(--space-1);
  }

  .nav-dropdown__overview {
    color: var(--color-accent) !important;
  }

  @media (min-width: 768px) {
    .nav-dropdown__panel {
      position: absolute;
      top: 100%;
      left: 0;
      min-width: 240px;
      margin-block-start: var(--space-2);
      background: var(--color-bg-elevated);
      border: 1px solid var(--color-border);
      z-index: 20;
      display: none;
    }

    /* Abre al pasar el mouse sobre todo el item (conveniencia, zona de hover amplia,
       no solo la flecha) o con `[open]` nativo — clic o teclado siguen funcionando
       exactamente igual sin esta regla, es puramente aditiva. */
    .site-header__nav-item:hover .nav-dropdown__panel,
    .nav-dropdown[open] .nav-dropdown__panel {
      display: grid;
    }

    .nav-dropdown__panel a {
      display: block;
      padding-block: var(--space-1);
      white-space: nowrap;
    }
  }

  .site-header__aside {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .site-header__phone,
  .site-header__lang {
    font-size: var(--text-small);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-header__lang {
    text-transform: uppercase;
    letter-spacing: var(--tracking-uppercase);
    color: var(--color-fg-muted);
    transition: color 0.3s ease;
  }

  .site-header__lang:hover {
    color: var(--color-fg);
  }

  /* ── Botón de tres rayas ───────────────────────────────────────────────────
     Las tres rayas son un solo `<span>` más sus dos pseudoelementos: la de en medio
     se desvanece al abrir y las otras dos rotan hasta formar la X. */
  .nav-toggle {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--color-border);
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .nav-toggle__bars,
  .nav-toggle__bars::before,
  .nav-toggle__bars::after {
    position: absolute;
    left: 50%;
    width: 20px;
    height: 2px;
    background: currentColor;
    transition:
      transform 0.25s ease,
      opacity 0.2s ease;
  }

  .nav-toggle__bars {
    top: 50%;
    transform: translate(-50%, -50%);
  }

  .nav-toggle__bars::before,
  .nav-toggle__bars::after {
    content: '';
    left: 0;
  }

  .nav-toggle__bars::before {
    transform: translateY(-6px);
  }

  .nav-toggle__bars::after {
    transform: translateY(6px);
  }

  [aria-expanded='true'] .nav-toggle__bars {
    background: transparent;
  }

  [aria-expanded='true'] .nav-toggle__bars::before {
    transform: translateY(0) rotate(45deg);
  }

  [aria-expanded='true'] .nav-toggle__bars::after {
    transform: translateY(0) rotate(-45deg);
  }

  /* ── Colapso en móvil ──────────────────────────────────────────────────────
     Todo lo de abajo depende de `.js` en <html>: sin JavaScript no se aplica nada y el
     menú queda desplegado y navegable. */
  @media (max-width: 767.98px) {
    :global(html.js) .nav-toggle {
      display: block;
    }

    :global(html.js) .site-header__panel {
      display: none;
      flex-basis: 100%;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
      padding-block: var(--space-3);
      border-block-start: 1px solid var(--color-border);
    }

    :global(html.js) .site-header__panel[data-open] {
      display: flex;
    }

    .site-header__nav {
      flex-direction: column;
      gap: var(--space-2);
    }

    /* Área de toque cómoda: los enlaces del menú abierto son fáciles de acertar. */
    .site-header__nav a {
      display: block;
      padding-block: var(--space-1);
      font-size: var(--text-body);
    }

    /* El panel del submenú baja a su propia fila bajo el link + la flecha, en vez de
       apretarse en la misma fila flex (no hay posicionamiento absoluto en móvil). */
    .site-header__nav-item {
      flex-wrap: wrap;
    }

    .nav-dropdown {
      flex: 1 0 100%;
    }

    .nav-dropdown__panel {
      padding-inline-start: var(--space-3);
      border-inline-start: 1px solid var(--color-border);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-toggle__bars,
    .nav-toggle__bars::before,
    .nav-toggle__bars::after {
      transition: none;
    }
  }
</style>

<script is:inline>
  (function () {
    var toggle = document.querySelector('[data-nav-toggle]');
    var panel = document.querySelector('[data-nav-panel]');
    if (!toggle || !panel) return;

    // Hay JS: el botón pasa a existir. Sin esto nunca se muestra.
    toggle.hidden = false;

    function setOpen(open) {
      toggle.setAttribute('aria-expanded', String(open));
      if (open) panel.setAttribute('data-open', '');
      else panel.removeAttribute('data-open');
    }

    toggle.addEventListener('click', function () {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // Escape cierra y devuelve el foco al botón, que es de donde salió.
    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    /* Al volver a escritorio el panel debe quedar visible aunque se cerrara en móvil:
       el CSS ya lo muestra, pero `aria-expanded="false"` mentiría sobre su estado. */
    var desktop = window.matchMedia('(min-width: 768px)');
    function sync() {
      if (desktop.matches) setOpen(false);
    }
    desktop.addEventListener('change', sync);
  })();
</script>
