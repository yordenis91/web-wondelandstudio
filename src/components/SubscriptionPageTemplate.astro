---
/**
 * Plantilla de página de servicio recurrente (`pageType: subscription`).
 *
 * Hermana de `ServicePageTemplate.astro` (`pageType: event`): comparte cabecera, hero,
 * secciones de prosa/pasos, testimonios, FAQ y CTA final, pero la sección de precios es
 * estructuralmente distinta — dos catálogos en paralelo (sesiones únicas + socio
 * mensual) en vez de una sola escalera de tiers — así que no cabía forzarla dentro de
 * `ServicePageTemplate` sin una rama condicional en cada punto de la plantilla.
 */
import Layout from './Layout.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import AnswerBlock from './AnswerBlock.astro';
import ProseSection from './ProseSection.astro';
import PortableText from './PortableText.astro';
import BookingSteps from './BookingSteps.astro';
import PricingTable from './PricingTable.astro';
import SubscriptionTable from './SubscriptionTable.astro';
import TestimonialList from './TestimonialList.astro';
import FAQ from './FAQ.astro';
import CTAWhatsApp from './CTAWhatsApp.astro';

import type { SubscriptionPageContent } from '../lib/pageContent.ts';
import type { Lang, City } from '../i18n/routes.ts';
import type { PricingEntry, TestimonialDoc } from '../lib/queries.ts';
import type { MonthlyLevelRow } from '../data/brandPricing.ts';
import { servicePageGraph, serviceId, type OfferInput } from '../lib/schema.ts';

interface Props {
  path: string;
  lang: Lang;
  city: City;
  content: SubscriptionPageContent;
  sessions: readonly PricingEntry[];
  monthlyLevels: readonly MonthlyLevelRow[];
  /** Ofertas para el `@graph`: sesiones únicas + socio mensual, dos catálogos en paralelo. */
  sessionOffers: readonly OfferInput[];
  monthlyOffers: readonly OfferInput[];
  serviceName: string;
  serviceType: string;
  areaServed: string;
  relatedServicePath?: string;
  testimonials?: readonly TestimonialDoc[];
  testimonialCategory: string;
  heroImage: { src: string; width: number; height: number };
  utmCampaign: string;
}

const {
  path,
  lang,
  city,
  content,
  sessions,
  monthlyLevels,
  sessionOffers,
  monthlyOffers,
  serviceName,
  serviceType,
  areaServed,
  relatedServicePath,
  testimonials = [],
  testimonialCategory,
  heroImage,
  utmCampaign,
} = Astro.props;

const sessionsCatalogName = lang === 'en' ? 'One-Time Sessions' : 'Sesiones Únicas';
const monthlyCatalogName = lang === 'en' ? 'Monthly Content Partnership' : 'Socio de Contenido Mensual';

const jsonLd = servicePageGraph({
  service: {
    path,
    name: serviceName,
    serviceType,
    city,
    areaServed,
    catalogs: [
      { name: sessionsCatalogName, offers: sessionOffers },
      { name: monthlyCatalogName, offers: monthlyOffers },
    ],
    relatedServiceId: relatedServicePath ? serviceId(relatedServicePath) : undefined,
  },
  faqs: content.faqs,
  breadcrumbs: content.breadcrumbs,
});
---

<Layout
  path={path}
  title={content.metaTitle}
  description={content.metaDescription}
  jsonLd={jsonLd}
>
  <Header slot="header" path={path} />

  <Hero
    eyebrow={content.hero.eyebrow}
    heading={content.h1}
    intro={undefined}
    image={{
      src: heroImage.src,
      alt: content.hero.alt,
      width: heroImage.width,
      height: heroImage.height,
    }}
  />

  <div class="container">
    <Breadcrumbs items={content.breadcrumbs} lang={lang} />

    <AnswerBlock text={content.answerParagraph} />

    {
      content.sectionsBeforePricing.map((section) =>
        section.kind === 'prose' ? (
          <ProseSection heading={section.heading} note={section.note} body={section.body} />
        ) : (
          <BookingSteps heading={section.heading} steps={section.steps} />
        ),
      )
    }

    <section class="pricing-section" id="sessions">
      <h2>{content.sessions.heading}</h2>
      <PricingTable entries={sessions} lang={lang} caption={content.sessions.note} />
      <PortableText blocks={content.sessions.afterTable} />
    </section>

    <section class="pricing-section" id="pricing">
      <h2>{content.monthly.heading}</h2>
      <SubscriptionTable
        levels={monthlyLevels}
        lang={lang}
        caption={content.monthly.note}
        levelLabel={content.monthly.levelLabel}
        photoLabel={content.monthly.photoLabel}
        videoLabel={content.monthly.videoLabel}
      />
      <PortableText blocks={content.monthly.afterTable} />
      <div class="pricing-section__ctas">
        <CTAWhatsApp
          label={content.monthly.ctaLabel}
          message={content.monthly.ctaMessage}
          location="pricing"
          utm={{ source: 'site', medium: 'pricing', campaign: utmCampaign }}
        />
        <a class="pricing-section__portfolio-link" href={content.monthly.portfolioLink.href}>
          {content.monthly.portfolioLink.label}
        </a>
      </div>
    </section>

    {
      content.sectionsAfterPricing.map((section) =>
        section.kind === 'prose' ? (
          <ProseSection heading={section.heading} note={section.note} body={section.body} />
        ) : (
          <BookingSteps heading={section.heading} steps={section.steps} />
        ),
      )
    }

    {/* No renderiza nada mientras no haya testimonios verificados (regla 5). */}
    <TestimonialList
      testimonials={testimonials}
      heading={content.testimonialsHeading}
      city={city}
      category={testimonialCategory}
    />

    <FAQ faqs={content.faqs} heading={content.faqHeading} />

    <section class="final-cta">
      <h2>{content.finalCta.heading}</h2>
      <p>{content.finalCta.body}</p>
      <CTAWhatsApp
        label={content.finalCta.label}
        message={content.finalCta.message}
        location="final-cta"
        utm={{ source: 'site', medium: 'cta-final', campaign: utmCampaign }}
        variant="fill"
      />
    </section>
  </div>
</Layout>

<style>
  .pricing-section,
  .final-cta {
    padding-block: var(--space-6);
  }

  .pricing-section p,
  .final-cta p {
    max-width: 70ch;
    line-height: 1.7;
  }

  .pricing-section__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-block-start: var(--space-3);
  }

  .pricing-section__portfolio-link {
    color: var(--color-fg);
    text-decoration-color: var(--color-border);
    text-underline-offset: 0.2em;
  }

  .final-cta {
    border-block-start: 1px solid var(--color-border);
  }
</style>
