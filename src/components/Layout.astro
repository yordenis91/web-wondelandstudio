---
/**
 * Layout base: `<head>` completo, canonical, hreflang recíproco y Open Graph.
 *
 * La reciprocidad de hreflang (regla 6 de CLAUDE.md) no se comprueba aquí a posteriori:
 * se deriva. Ambas caras salen de `getAlternate()` sobre el mismo mapa central, así que
 * es imposible declarar una sin la otra. Si la ruta no está en el mapa, el build falla
 * con el path concreto — un `hreflang` roto en producción es peor que un build rojo.
 */
import { getAlternate, getLang, normalizePath } from '../i18n/routes.ts';
import { BUSINESS } from '../data/business.ts';
import { serializeJsonLd, type JsonLdGraph } from '../lib/schema.ts';
import '../styles/global.css';

interface Props {
  /** Ruta canónica de esta página, con barra inicial y final. */
  path: string;
  title: string;
  description: string;
  /** Ruta absoluta o URL de la imagen social. */
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: JsonLdGraph;
}

const {
  path,
  title,
  description,
  ogImage = '/og-default.jpg',
  ogType = 'website',
  noindex = false,
  jsonLd,
} = Astro.props;

const canonicalPath = normalizePath(path);
const lang = getLang(canonicalPath);

const enPath = getAlternate(canonicalPath, 'en');
const esPath = getAlternate(canonicalPath, 'es');

if (!enPath || !esPath) {
  throw new Error(
    `hreflang sin par para "${canonicalPath}": ` +
      `EN=${enPath ?? 'ausente'} ES=${esPath ?? 'ausente'}. ` +
      `Toda página declara sus dos caras (CLAUDE.md regla 6) — ` +
      `añádela a ROUTES en src/i18n/routes.ts.`,
  );
}

const abs = (p: string) => `${BUSINESS.siteUrl}${p}`;

const canonicalUrl = abs(canonicalPath);
const ogImageUrl = ogImage.startsWith('http') ? ogImage : abs(ogImage);
const ogLocale = lang === 'en' ? 'en_US' : 'es_US';
const ogLocaleAlt = lang === 'en' ? 'es_US' : 'en_US';
---

<!doctype html>
<html lang={lang === 'en' ? 'en-US' : 'es-US'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      Google Tag Manager, lo más arriba del <head> posible — es la instalación estándar
      de Google, para que capture los eventos tempranos de la página. El script en sí
      carga async (`j.async = true`), así que no bloquea el primer pintado ni empuja el
      LCP — el listener de `[data-wa-cta]` de más abajo ya empuja a `dataLayer` desde
      antes de que existiera un contenedor real que lo leyera; esto es lo que por fin
      lo recibe.
    */}
    <script is:inline define:vars={{ gtmId: BUSINESS.gtmId }}>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', gtmId);
    </script>

    {/*
      Marca que hay JavaScript, antes del primer pintado. El menú móvil solo se colapsa
      si esta clase está: sin JS la navegación se sirve desplegada y usable, y como esto
      corre en el <head> y no al final del body, nunca se ve el menú abierto un instante
      antes de cerrarse.
    */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonicalUrl} />

    {/* Recíproco por construcción: las dos caras salen del mismo mapa. */}
    <link rel="alternate" hreflang="en-US" href={abs(enPath)} />
    <link rel="alternate" hreflang="es-US" href={abs(esPath)} />
    <link rel="alternate" hreflang="x-default" href={abs(enPath)} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={BUSINESS.legalName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/*
      La fuente se autoaloja (ver el @font-face de global.css), así que no hay
      `preconnect` a Google: no hay tercer origen al que conectarse. El `preload` la
      pide en paralelo al CSS en vez de esperar a que el navegador descubra el
      @font-face al parsearlo, que es lo que retrasa el texto.
    */}
    <link
      rel="preload"
      href="/fonts/montserrat-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {
      jsonLd && (
        <script
          is:inline
          type="application/ld+json"
          set:html={serializeJsonLd(jsonLd)}
        />
      )
    }
  </head>
  <body>
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${BUSINESS.gtmId}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"
      />
    </noscript>

    <a class="skip-link" href="#main">
      {lang === 'en' ? 'Skip to content' : 'Saltar al contenido'}
    </a>

    <slot name="header" />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <slot name="footer" />

    {/*
      Único JS de la página: un listener delegado para los CTA de WhatsApp. Vive aquí y
      no en CTAWhatsApp.astro para que exista una sola vez por página en vez de una por
      botón. No participa en el render del contenido (regla 1 de CLAUDE.md) — el enlace
      funciona igual sin JS, esto solo añade la señal de analítica.
    */}
    <script is:inline>
      document.addEventListener('click', function (event) {
        var cta = event.target.closest('[data-wa-cta]');
        if (!cta) return;
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: 'whatsapp_click',
          wa_location: cta.getAttribute('data-wa-location') || '',
          wa_page: window.location.pathname,
        });
      });
    </script>
  </body>
</html>
