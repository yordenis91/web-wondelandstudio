---
/**
 * `/es/west-palm-beach/` — hub de ciudad. Contenido literal de
 * `docs/copy/city-hubs-copydeck.md` §4 (versión ES, escrita nativa).
 */
import HubPageTemplate from '../../../components/HubPageTemplate.astro';
import { HUB_WPB } from '../../../content/hub-wpb.ts';

const lang = 'es' as const;
const path = '/es/west-palm-beach/';
---

