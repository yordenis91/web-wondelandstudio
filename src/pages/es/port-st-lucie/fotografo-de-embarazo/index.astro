  lang={lang}
  city="psl"
  content={PSL_MATERNITY_PHOTOGRAPHER[lang]}
  pricing={getMaternityPricing(lang)}
  offers={getMaternityOffers(lang)}
  serviceName="Fotografía de Embarazo en Port St. Lucie"
  serviceType="Maternity Photography"
  areaServed="Port St. Lucie"
  areaServedType="City"
  testimonialCategory="maternity"
  heroImage={{ src: '/hero-placeholder.svg', width: 1600, height: 900 }}
  utmCampaign="psl-maternity-photographer-es"
/>
