---
/**
 * `/es/portafolio/[categoria]/` — pageType: portfolio. Ver
 * `pages/portfolio/[category].astro` para el resto de la nota.
 */
import PortfolioPageTemplate from '../../../components/PortfolioPageTemplate.astro';
import { PORTFOLIO_CATEGORIES } from '../../../i18n/routes.ts';
import { getPortfolioContent, getPortfolioH1, getPortfolioImages } from '../../../content/portfolio.ts';
import { photo, type PhotoId } from '../../../lib/images.ts';

export function getStaticPaths() {
  return PORTFOLIO_CATEGORIES.map((category) => ({ params: { categoria: category.es } }));
}

const lang = 'es' as const;
const { categoria: slug } = Astro.params;
const category = PORTFOLIO_CATEGORIES.find((c) => c.es === slug)!;
const path = `/es/portafolio/${category.es}/`;

const breadcrumbs = [{ name: 'Inicio', path: '/es/' }, { name: getPortfolioH1(category.id, lang) }];
const content = getPortfolioContent(category.id, lang, breadcrumbs);
const images = getPortfolioImages(category.id, lang);

/** Una foto por categoría hasta que haya galería real; la quinceañera aún no tiene categoría. */
const HERO_PHOTO: Record<(typeof PORTFOLIO_CATEGORIES)[number]['id'], PhotoId> = {
  weddings: 'wedding',
  branding: 'brand-studio',
  maternity: 'maternity',
};
---

<PortfolioPageTemplate
  path={path}
  lang={lang}
  content={content}
  images={images}
  heroImage={photo(HERO_PHOTO[category.id])}
  utmCampaign={`portfolio-${category.id}-es`}
/>
