---
import { getLocation } from '../data/business.ts';
import '../styles/global.css';

const wpb = getLocation('wpb');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <title>Wonderlands Studio</title>
  </head>
  <body>
    <main class="container" style="padding-block: var(--space-8);">
      <span class="eyebrow">Estudio fotográfico y de video</span>
      <h1>Wonderlands Studio</h1>
      <p>Photography and video in South Florida.</p>
      <a class="button" href={`tel:${wpb.phone.e164}`}>{wpb.phone.display}</a>
    </main>
  </body>
</html>
